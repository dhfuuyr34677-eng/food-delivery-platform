# Database
DB_USER=fduser
DB_PASSWORD=<change-me>
DB_NAME=food_delivery

# JWT
JWT_SECRET=<change-me-use-random-64-char-string>

# MinIO / Object Storage
MINIO_ACCESS_KEY=<change-me>
MINIO_SECRET_KEY=<change-me>
MINIO_BUCKET=food-delivery
MINIO_PUBLIC_URL=https://your-domain.com/uploads

# CORS (comma-separated origins or * for all)
CORS_ORIGIN=*

# WeChat Mini Program
WECHAT_APP_ID=<your-app-id>
WECHAT_APP_SECRET=<your-app-secret>

# WeChat Pay v3
WECHAT_PAY_MCH_ID=<your-mch-id>
WECHAT_PAY_API_KEY_V3=<your-api-v3-key>
WECHAT_PAY_SERIAL_NO=<your-cert-serial>
WECHAT_PAY_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://your-domain.com/api/order/payment/callback

# Nginx
NGINX_PORT=80
