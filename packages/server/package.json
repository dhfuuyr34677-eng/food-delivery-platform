    "drizzle-zod": "^0.7.0",
    "hono": "^4.6.0",
    "ioredis": "^5.4.0",
    "jose": "^5.9.0",
    "minio": "^8.0.0",
    "postgres": "^3.4.0",
    "sharp": "^0.33.0",
    "uuid": "^11.0.0",
    "ws": "^8.18.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.0",
