<view class="container">
  <view class="order-card" wx:for="{{orders}}" wx:key="id">
    <view class="order-no">{{item.orderNo}}</view>
    <view class="status">{{item.status}}</view>
    <view class="amount">¥{{item.amountText}}</view>
    <view class="addr">{{item.addrText}}</view>
    <view class="actions">
      <view class="action-btn" wx:for="{{item.actions}}" wx:key="action"
        bindtap="doAction" data-id="{{item.id}}" data-action="{{item.action}}">
        {{item.label}}
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{orders.length === 0}}">暂无订单</view>
</view>
<custom-tab-bar selected="0" />
