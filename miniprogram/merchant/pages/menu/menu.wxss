.container { padding: 16rpx; }
.product-item { background: #fff; border-radius: 12rpx; padding: 24rpx; margin-bottom: 12rpx; display: flex; justify-content: space-between; align-items: center; }
.name { font-size: 30rpx; }
.price { font-size: 26rpx; color: #ff6b35; margin-top: 4rpx; }
.toggle { color: #ff6b35; font-size: 26rpx; }
.add-btn { text-align: center; padding: 32rpx; color: #ff6b35; font-size: 30rpx; background: #fff; border-radius: 12rpx; margin-top: 16rpx; }
