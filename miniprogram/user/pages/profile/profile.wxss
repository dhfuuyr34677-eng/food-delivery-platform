.container { padding: 16rpx; }
.user-header { background: linear-gradient(135deg, #ff6b35, #ff8c5a); border-radius: 16rpx; padding: 48rpx 32rpx; color: #fff; }
.nickname { font-size: 36rpx; font-weight: bold; }
.phone { font-size: 26rpx; margin-top: 8rpx; opacity: 0.8; }
.login-btn { text-align: center; padding: 24rpx; border: 2rpx solid #fff; border-radius: 40rpx; font-size: 30rpx; }
.menu-list { margin-top: 24rpx; background: #fff; border-radius: 16rpx; }
.menu-item { display: flex; justify-content: space-between; padding: 28rpx 24rpx; border-bottom: 1rpx solid #f5f5f5; font-size: 30rpx; }
.arrow { color: #ccc; }
