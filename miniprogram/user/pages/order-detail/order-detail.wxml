<view class="container" wx:if="{{order}}">
  <view class="status-bar">{{order.status}}</view>
  <view class="info-card">
    <view class="label">配送地址</view>
    <view>{{order.addressSnapshot.contactName}} {{order.addressSnapshot.phone}}</view>
    <view>{{order.addressSnapshot.address}}</view>
  </view>
  <view class="info-card">
    <view class="label">商品清单</view>
    <view class="item" wx:for="{{order.items}}" wx:key="id">
      <view>{{item.productSnapshot.name}} x{{item.quantity}}</view>
      <view>¥{{item.amountText}}</view>
    </view>
  </view>
  <view class="info-card">
    <view class="label">订单信息</view>
    <view>订单号: {{order.orderNo}}</view>
    <view>总金额: ¥{{order.amountText}}</view>
    <view>下单时间: {{order.createdAt}}</view>
  </view>
  <view class="cancel-btn" bindtap="cancelOrder" wx:if="{{canCancel}}">取消订单</view>
</view>
