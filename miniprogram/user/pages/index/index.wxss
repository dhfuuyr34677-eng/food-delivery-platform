.container { padding: 16rpx; }
.search-bar { padding: 20rpx 0; }
.search-input { background: #fff; border-radius: 32rpx; padding: 16rpx 32rpx; font-size: 28rpx; }
.shop-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; display: flex; }
.shop-logo { width: 120rpx; height: 120rpx; border-radius: 12rpx; flex-shrink: 0; }
.shop-info { margin-left: 20rpx; flex: 1; }
.shop-name { font-size: 32rpx; font-weight: bold; color: #333; }
.shop-desc { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.shop-meta { font-size: 22rpx; color: #bbb; margin-top: 4rpx; }
.empty { text-align: center; padding: 120rpx 0; color: #999; font-size: 28rpx; }
.loading { text-align: center; padding: 120rpx 0; }
