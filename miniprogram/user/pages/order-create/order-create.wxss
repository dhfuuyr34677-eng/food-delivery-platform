.container { padding: 16rpx; }
.section { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.section-title { font-size: 28rpx; font-weight: bold; margin-bottom: 16rpx; }
.addr-card { border: 2rpx solid #ff6b35; border-radius: 12rpx; padding: 20rpx; }
.addr-detail { font-size: 24rpx; color: #999; margin-top: 8rpx; }
.addr-empty { text-align: center; color: #ff6b35; padding: 24rpx; }
.remark-input { background: #f5f5f5; border-radius: 8rpx; padding: 16rpx; font-size: 28rpx; }
.submit-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 32rpx; background: #fff; }
.submit-btn { background: #ff6b35; color: #fff; text-align: center; padding: 24rpx; border-radius: 40rpx; font-size: 32rpx; }
.submit-btn.disabled { opacity: 0.5; }
