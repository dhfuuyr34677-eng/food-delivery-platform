.container { padding: 16rpx; }
.shop-header { text-align: center; padding: 40rpx 0; }
.shop-logo { width: 160rpx; height: 160rpx; border-radius: 16rpx; }
.shop-name { font-size: 36rpx; font-weight: bold; margin-top: 16rpx; }
.shop-desc { font-size: 26rpx; color: #999; margin-top: 8rpx; }
.section-title { font-size: 30rpx; font-weight: bold; padding: 24rpx 0 12rpx; }
.product-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; background: #fff; border-radius: 12rpx; margin-bottom: 12rpx; }
.product-name { font-size: 30rpx; }
.product-price { font-size: 28rpx; color: #ff6b35; font-weight: bold; margin-top: 8rpx; }
.product-actions { display: flex; align-items: center; gap: 16rpx; }
.btn-minus, .btn-plus { width: 48rpx; height: 48rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: bold; }
.btn-plus { background: #ff6b35; color: #fff; }
.btn-minus { border: 2rpx solid #ff6b35; color: #ff6b35; }
.count { font-size: 28rpx; min-width: 32rpx; text-align: center; }
.cart-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding: 20rpx 32rpx; display: flex; justify-content: space-between; align-items: center; border-top: 1rpx solid #eee; }
.cart-info { font-size: 30rpx; font-weight: bold; }
.cart-btn { background: #ff6b35; color: #fff; padding: 16rpx 48rpx; border-radius: 40rpx; font-size: 30rpx; }
