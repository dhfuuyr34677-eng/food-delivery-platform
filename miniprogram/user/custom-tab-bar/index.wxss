.tab-bar{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:1rpx solid #eee;padding-bottom:env(safe-area-inset-bottom)}
.tab-item{flex:1;display:flex;flex-direction:column;align-items:center;padding:8rpx 0}
.tab-icon{width:44rpx;height:44rpx}
.tab-text{font-size:22rpx;color:#999;margin-top:4rpx}
.tab-text.active{color:#ff6b35}
