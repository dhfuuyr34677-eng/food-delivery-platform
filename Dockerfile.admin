# Stage 1: Build admin SPA
FROM node:22-alpine AS builder

RUN corepack enable && corepack prepare pnpm@11.7.0 --activate

WORKDIR /app

COPY .npmrc pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json package.json ./
COPY packages/admin/package.json packages/admin/tsconfig.json packages/admin/vite.config.ts packages/admin/index.html ./packages/admin/

RUN pnpm install --frozen-lockfile

COPY packages/admin/src ./packages/admin/src
COPY packages/shared ./packages/shared

RUN pnpm build:admin

# Stage 2: Serve with nginx
FROM nginx:alpine

COPY --from=builder /app/packages/admin/dist /usr/share/nginx/html
COPY nginx/admin-spa.nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
