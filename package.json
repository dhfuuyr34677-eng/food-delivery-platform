{
  "name": "food-delivery-platform",
  "private": true,
  "scripts": {
    "dev:server": "pnpm --filter @fd/server dev",
    "dev:admin": "pnpm --filter @fd/admin dev",
    "build:shared": "pnpm --filter @fd/shared build",
    "build:server": "pnpm --filter @fd/server build",
    "build:admin": "pnpm --filter @fd/admin build",
    "build:all": "pnpm build:shared && pnpm build:server && pnpm build:admin",
    "db:generate": "pnpm --filter @fd/server db:generate",
    "db:migrate": "pnpm --filter @fd/server db:migrate",
    "db:push": "pnpm --filter @fd/server db:push",
    "db:seed": "pnpm --filter @fd/server db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
